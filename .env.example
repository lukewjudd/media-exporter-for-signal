# Copy to .env and fill in. Never commit .env.

# Your Signal recovery key, exactly as Signal shows it or saved it to your
# password manager (the "password" field). Spaces are fine, and so are the
# "=" and "#" characters: the iPhone app shows 0 as "=" and O as "#".
# Anyone with this key can decrypt your backups: leave it blank to be
# prompted instead, or delete .env after running.
SIGNAL_RECOVERY_KEY=

# Optional: how your own messages are labelled in the archive (default "Me").
# (The "username" Signal saved in your password manager is your account ID;
# it isn't needed here.)
SIGNAL_SELF_NAME=
