{
  "name": "media-exporter-for-signal",
  "version": "0.1.0",
  "description": "Archive, browse and tidy the photos and videos in your iPhone Signal backups, entirely on your Mac.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "setup": "node src/setup.mjs",
    "sync": "node src/extract.mjs && node src/build-db.mjs && node src/dashboard.mjs && node src/viewer.mjs && node src/clip.mjs && node src/faces.mjs && node src/people.mjs && node src/viewer.mjs",
    "view": "node src/serve.mjs",
    "extract": "node src/extract.mjs",
    "db": "node src/build-db.mjs",
    "dashboard": "node src/dashboard.mjs",
    "viewer": "node src/viewer.mjs",
    "clip": "node src/clip.mjs",
    "faces": "node src/faces.mjs",
    "people": "node src/people.mjs",
    "export-photos": "node src/export-photos.mjs",
    "test": "node test/selftest.mjs",
    "demo:build": "node demo/build.mjs",
    "demo": "SIGNAL_ARCHIVE_DATA=demo/data node src/serve.mjs 8780"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@huggingface/transformers": "^4.3.1",
    "@signalapp/libsignal-client": "^0.105.1",
    "ffmpeg-static": "^5.3.0",
    "protobufjs": "^8.8.1",
    "sharp": "^0.35.5"
  }
}
